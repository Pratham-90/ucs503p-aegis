# Copy to .env (never commit real values). On Vercel set these under
# Project -> Settings -> Environment Variables (Production and Preview).

# SQLite locally; on Vercel the Neon integration injects a postgres:// URL.
DATABASE_URL=sqlite:///./aegis.db

# Long random strings, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
CRON_SECRET=change-me
DEMO_ADMIN_TOKEN=change-me

# log = in-app Outbox only (works without an email domain); resend = also send via Resend.
EMAIL_MODE=log
RESEND_API_KEY=
EMAIL_FROM=Aegis <onboarding@resend.dev>

# Public URL of the deployment, used in emailed links (no trailing slash).
APP_BASE_URL=http://localhost:5173

# true allows minute-scale schedules and the Demo Console clock fast-forward;
# false enforces check-in intervals of at least one day.
DEMO_MODE=true

# Used only by scripts/seed_demo.py (the demo owner's password; not committed).
DEMO_OWNER_PASSWORD=
